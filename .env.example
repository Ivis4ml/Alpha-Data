# Alpha-Data 凭证模板。复制为 .env 并填入真实值；.env 不入库。

# --- massive.com (Polygon.io 更名) ---
# REST API key：参考数据、拆股/分红、分钟线补缺。兼容旧名 POLYGON_API_KEY。
MASSIVE_API_KEY=
# 兼容别名（如沿用既有 Polygon 工具，可只填其一）。
# POLYGON_API_KEY=

# Flat Files (S3) 凭证：批量下载历史分钟线。需在 Dashboard 单独生成，与 REST key 不同。
MASSIVE_S3_ACCESS_KEY_ID=
MASSIVE_S3_SECRET_ACCESS_KEY=
# S3 端点与桶（一般无需改动）。
MASSIVE_S3_ENDPOINT=https://files.massive.com
MASSIVE_S3_BUCKET=flatfiles

# --- HuggingFace ---
# Polymarket 数据集下载。只读 scope 即可；公开数据集非强制，建议提供以提升吞吐与稳定性。
HF_TOKEN=
